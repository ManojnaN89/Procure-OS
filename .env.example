# Copy to .env and fill in. .env is never committed.

# --- local services (docker-compose.yml) ---
POSTGRES_USER=p2p
POSTGRES_PASSWORD=change-me
POSTGRES_DB=p2p_control
POSTGRES_PORT=5440
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- backend ---
CONTROL_DATABASE_URL=postgresql+psycopg://p2p:change-me@localhost:5440/p2p_control
# Key used to encrypt tenant database connection strings (generate with: python scripts/make_key.py)
TENANT_SECRET_KEY=
JWT_SECRET=change-me-too
SMTP_HOST=localhost
SMTP_PORT=1025

# --- AI providers (free tiers, synthetic data only). Enter these yourself, never paste them in chat ---
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
