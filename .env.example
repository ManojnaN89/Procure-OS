# Copy to .env and fill in. .env is never committed.

# --- local services (docker-compose.yml) ---
POSTGRES_USER=p2p
POSTGRES_PASSWORD=change-me
POSTGRES_DB=p2p_control
POSTGRES_PORT=5440
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- backend ---
CONTROL_DATABASE_URL=postgresql+psycopg://p2p:change-me@127.0.0.1:5440/p2p_control
# Key used to encrypt tenant database connection strings (generate with: python scripts/make_key.py)
TENANT_SECRET_KEY=
JWT_SECRET=change-me-too
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# --- AI providers (free tiers, synthetic data only). Enter these yourself, never paste them in chat ---
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=   # free trial from build.nvidia.com: development and testing only, not production
ANTHROPIC_API_KEY=

# Optional: choose the model per step. JSON, provider names: groq, gemini, openrouter, ollama, anthropic
# MODEL_ROUTES={"default": [["groq", "openai/gpt-oss-120b"], ["gemini", "gemini-2.5-flash"]]}
OPENROUTER_API_KEY=

# Optional
# EXTRA_MODULES=my_tools   # modules imported at startup that register agent tools and executors
# IMAP_HOST= / IMAP_USER= / IMAP_PASSWORD=   # read a real mailbox instead of Mailpit
# Optional: override the free-tier limits the gateway paces itself by (see docs/model-selection.md)
# MODEL_LIMITS={"groq/openai/gpt-oss-120b": {"rpm": 30, "tpm": 8000, "rpd": 1000}, "nvidia": {"rpm": 30}}
